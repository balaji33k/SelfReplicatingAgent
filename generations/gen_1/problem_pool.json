{
  "training": {
    "problems": [
      {
        "id": "bench_001",
        "name": "Two Sum",
        "description": "Given a list of integers and a target, return indices of two numbers that sum to target.",
        "category": "array",
        "difficulty": "easy",
        "function_signature": "def two_sum(nums: list, target: int) -> list:",
        "constraints": [
          "Time limit: 5 seconds",
          "Memory limit: 256 MB"
        ],
        "test_cases": [
          {
            "input": {
              "nums": [
                2,
                7,
                11,
                15
              ],
              "target": 9
            },
            "expected": [
              0,
              1
            ]
          },
          {
            "input": {
              "nums": [
                3,
                2,
                4
              ],
              "target": 6
            },
            "expected": [
              1,
              2
            ]
          },
          {
            "input": {
              "nums": [
                3,
                3
              ],
              "target": 6
            },
            "expected": [
              0,
              1
            ]
          }
        ],
        "timeout_seconds": 5
      },
      {
        "id": "bench_002",
        "name": "Maximum Subarray",
        "description": "Find the contiguous subarray with the largest sum (Kadane's algorithm).",
        "category": "array",
        "difficulty": "medium",
        "function_signature": "def max_subarray(nums: list) -> int:",
        "constraints": [
          "Time limit: 5 seconds",
          "Memory limit: 256 MB"
        ],
        "test_cases": [
          {
            "input": {
              "nums": [
                -2,
                1,
                -3,
                4,
                -1,
                2,
                1,
                -5,
                4
              ]
            },
            "expected": 6
          },
          {
            "input": {
              "nums": [
                1
              ]
            },
            "expected": 1
          },
          {
            "input": {
              "nums": [
                5,
                4,
                -1,
                7,
                8
              ]
            },
            "expected": 23
          }
        ],
        "timeout_seconds": 5
      },
      {
        "id": "bench_003",
        "name": "Move Zeroes",
        "description": "Move all zeroes to the end of the list while preserving relative order of non-zero elements.",
        "category": "array",
        "difficulty": "easy",
        "function_signature": "def move_zeroes(nums: list) -> list:",
        "constraints": [
          "Time limit: 5 seconds",
          "Memory limit: 256 MB"
        ],
        "test_cases": [
          {
            "input": {
              "nums": [
                0,
                1,
                0,
                3,
                12
              ]
            },
            "expected": [
              1,
              3,
              12,
              0,
              0
            ]
          },
          {
            "input": {
              "nums": [
                0
              ]
            },
            "expected": [
              0
            ]
          },
          {
            "input": {
              "nums": [
                1,
                2,
                3
              ]
            },
            "expected": [
              1,
              2,
              3
            ]
          }
        ],
        "timeout_seconds": 5
      },
      {
        "id": "bench_004",
        "name": "Rotate Array",
        "description": "Rotate a list to the right by k steps.",
        "category": "array",
        "difficulty": "easy",
        "function_signature": "def rotate_array(nums: list, k: int) -> list:",
        "constraints": [
          "Time limit: 5 seconds",
          "Memory limit: 256 MB"
        ],
        "test_cases": [
          {
            "input": {
              "nums": [
                1,
                2,
                3,
                4,
                5,
                6,
                7
              ],
              "k": 3
            },
            "expected": [
              5,
              6,
              7,
              1,
              2,
              3,
              4
            ]
          },
          {
            "input": {
              "nums": [
                -1,
                -100,
                3,
                99
              ],
              "k": 2
            },
            "expected": [
              3,
              99,
              -1,
              -100
            ]
          }
        ],
        "timeout_seconds": 5
      },
      {
        "id": "bench_005",
        "name": "Product of Array Except Self",
        "description": "Return an array where each element is the product of all others (no division).",
        "category": "array",
        "difficulty": "medium",
        "function_signature": "def product_except_self(nums: list) -> list:",
        "constraints": [
          "Time limit: 5 seconds",
          "Memory limit: 256 MB"
        ],
        "test_cases": [
          {
            "input": {
              "nums": [
                1,
                2,
                3,
                4
              ]
            },
            "expected": [
              24,
              12,
              8,
              6
            ]
          },
          {
            "input": {
              "nums": [
                -1,
